<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pulse Animation for Connect Button Glow -->
    <Storyboard x:Key="PulseGlowAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(Effect).(DropShadowEffect.BlurRadius)"
                         From="20" To="50" Duration="0:0:2"
                         AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetProperty="(Effect).(DropShadowEffect.Opacity)"
                         From="0.4" To="0.9" Duration="0:0:2"
                         AutoReverse="True" />
    </Storyboard>

    <!-- Pulse for outer ring -->
    <Storyboard x:Key="PulseRingAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.6" To="0.0" Duration="0:0:2" />
        <DoubleAnimation Storyboard.TargetProperty="Width"
                         From="160" To="240" Duration="0:0:2" />
        <DoubleAnimation Storyboard.TargetProperty="Height"
                         From="160" To="240" Duration="0:0:2" />
    </Storyboard>

    <!-- Rotating Gradient Animation -->
    <Storyboard x:Key="RotateGradientAnimation" RepeatBehavior="Forever">
        <PointAnimation Storyboard.TargetProperty="(LinearGradientBrush.StartPoint)"
                        From="0,0" To="1,0" Duration="0:0:4"
                        AutoReverse="True" />
        <PointAnimation Storyboard.TargetProperty="(LinearGradientBrush.EndPoint)"
                        From="1,1" To="0,1" Duration="0:0:4"
                        AutoReverse="True" />
    </Storyboard>

    <!-- Spinner Rotation -->
    <Storyboard x:Key="SpinnerRotationAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                         From="0" To="360" Duration="0:0:1.5" />
    </Storyboard>

    <!-- Fade In -->
    <Storyboard x:Key="FadeInAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.4" />
    </Storyboard>

    <!-- Slide Up + Fade In -->
    <Storyboard x:Key="SlideUpFadeInAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5" />
        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                            From="0,30,0,0" To="0,0,0,0" Duration="0:0:0.5" />
    </Storyboard>

    <!-- Connection State Color Animation -->
    <ColorAnimation x:Key="ConnectedColorAnimation"
                    To="#00E676" Duration="0:0:0.4" />
    <ColorAnimation x:Key="DisconnectedColorAnimation"
                    To="#7C4DFF" Duration="0:0:0.4" />

</ResourceDictionary>
