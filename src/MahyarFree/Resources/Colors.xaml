<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Colors -->
    <Color x:Key="PrimaryColor">#7C4DFF</Color>
    <Color x:Key="SecondaryColor">#536DFE</Color>
    <Color x:Key="AccentColor">#00E5FF</Color>

    <!-- Background Colors -->
    <Color x:Key="BackgroundDarkColor">#0A0E27</Color>
    <Color x:Key="BackgroundMediumColor">#141A3A</Color>
    <Color x:Key="BackgroundLightColor">#1E2553</Color>
    <Color x:Key="SurfaceColor">#252B5C</Color>
    <Color x:Key="CardColor">#2A3270</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#B0B8E0</Color>
    <Color x:Key="TextTertiaryColor">#6E76A8</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#00E676</Color>
    <Color x:Key="WarningColor">#FFB300</Color>
    <Color x:Key="ErrorColor">#FF5252</Color>
    <Color x:Key="InfoColor">#448AFF</Color>

    <!-- Gradient Colors -->
    <Color x:Key="GradientStartColor">#7C4DFF</Color>
    <Color x:Key="GradientMiddleColor">#536DFE</Color>
    <Color x:Key="GradientEndColor">#00E5FF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDarkColor}" />
    <SolidColorBrush x:Key="BackgroundMediumBrush" Color="{StaticResource BackgroundMediumColor}" />
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLightColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <!-- Primary Gradient -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GradientStartColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource GradientMiddleColor}" Offset="0.5" />
        <GradientStop Color="{StaticResource GradientEndColor}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Background Gradient -->
    <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundDarkColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource BackgroundMediumColor}" Offset="0.5" />
        <GradientStop Color="{StaticResource BackgroundLightColor}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Radial Glow Brush for connect button -->
    <RadialGradientBrush x:Key="GlowBrush" Center="0.5,0.5" GradientStops="{Binding}">
        <GradientStop Color="#7C4DFF" Offset="0.0" />
        <GradientStop Color="#00536DFE" Offset="0.5" />
        <GradientStop Color="Transparent" Offset="1.0" />
    </RadialGradientBrush>

</ResourceDictionary>
