<Window x:Class="MahyarFree.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:vm="clr-namespace:MahyarFree.ViewModels"
        xmlns:models="clr-namespace:MahyarFree.Models"
        Title="Mahyar Free"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource GlassWindowStyle}"
        Background="{StaticResource BackgroundGradientBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#10FFFFFF" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource PrimaryGradientBrush}">
                        <TextBlock Text="M" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Mahyar Free" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Powered by sing-box" Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize" />
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Connection Card -->
            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,15,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Status Header -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                        <TextBlock Text="STATUS" Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <Border x:Name="StatusIndicator" Width="12" Height="12" CornerRadius="6"
                                Background="{Binding StatusColor}" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect x:Name="StatusGlow" Color="#7C4DFF" BlurRadius="20" Opacity="0.6" />
                            </Border.Effect>
                        </Border>
                        <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText}"
                                   FontSize="26" FontWeight="Bold" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <!-- Big Connect Button with Glow Animation -->
                    <Grid Grid.Row="1" Width="200" Height="200" HorizontalAlignment="Center" Margin="0,20,0,30">
                        <!-- Outer Pulse Ring -->
                        <Border x:Name="PulseRing" Width="180" Height="180" CornerRadius="90"
                                Background="Transparent" BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="2" Opacity="0.6" />
                        <!-- Glow Background -->
                        <Ellipse x:Name="GlowEllipse" Width="180" Height="180">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#407C4DFF" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Main Button -->
                        <Button x:Name="ConnectButton" Width="150" Height="150" Cursor="Hand"
                                Click="ConnectButton_Click" IsEnabled="{Binding IsNotBusy}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="ButtonEllipse">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#7C4DFF" Offset="0" />
                                                    <GradientStop Color="#536DFE" Offset="0.5" />
                                                    <GradientStop Color="#00E5FF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="ButtonGlow" Color="#7C4DFF"
                                                                  BlurRadius="30" Opacity="0.8" ShadowDepth="0" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonEllipse" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="ButtonGlow" Property="BlurRadius" Value="45" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ButtonEllipse" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="ConnectText" Text="CONNECT" Foreground="White"
                                       FontSize="20" FontWeight="Bold" />
                        </Button>
                    </Grid>

                    <!-- Selected Server Info -->
                    <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="15" Margin="0,0,0,15"
                            Background="#10FFFFFF">
                        <StackPanel>
                            <TextBlock Text="SELECTED SERVER" Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                        Background="{Binding SelectedConfig.ProtocolColor}" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding SelectedConfig.ProtocolIcon}"
                                               Foreground="White" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedConfig.Name, FallbackValue='No server selected', TargetNullValue='No server selected'}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedConfig.Address, FallbackValue='Please fetch configs first'}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SelectedConfig.PingDisplay, FallbackValue='--'}"
                                               Foreground="{Binding SelectedConfig.PingColor, FallbackValue='#6E76A8'}"
                                               FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" />
                                    <TextBlock Text="PING" Style="{StaticResource CaptionTextStyle}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Traffic Stats -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,0,4,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↓" Foreground="{StaticResource AccentBrush}" FontSize="14"
                                               FontWeight="Bold" Margin="0,0,6,0" />
                                    <TextBlock Text="DOWNLOAD" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding TrafficStats.DownloadSpeedDisplay, FallbackValue='0 B/s'}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding TrafficStats.TotalDownloadDisplay, FallbackValue='0 B'}"
                                           Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="12" Margin="4,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↑" Foreground="{StaticResource PrimaryBrush}" FontSize="14"
                                               FontWeight="Bold" Margin="0,0,6,0" />
                                    <TextBlock Text="UPLOAD" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding TrafficStats.UploadSpeedDisplay, FallbackValue='0 B/s'}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding TrafficStats.TotalUploadDisplay, FallbackValue='0 B'}"
                                           Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: Server List + Controls -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Servers" Style="{StaticResource HeadingTextStyle}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1" x:Name="AutoSelectButton" Style="{StaticResource ModernButtonStyle}"
                            Margin="0,0,8,0" Click="AutoSelectButton_Click"
                            IsEnabled="{Binding IsNotBusy}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Auto Best" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" x:Name="TestPingButton" Style="{StaticResource ModernButtonStyle}"
                            Margin="0,0,8,0" Click="TestPingButton_Click"
                            IsEnabled="{Binding IsNotBusy}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Test Ping" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" x:Name="FetchButton" Style="{StaticResource PrimaryButtonStyle}"
                            Click="FetchButton_Click" IsEnabled="{Binding IsNotBusy}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⟳" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Fetch New" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Server List -->
                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="10">
                    <Grid>
                        <!-- Empty State -->
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Configs.Count, Converter={StaticResource InvertedBoolToVis}}">
                            <TextBlock Text="🌐" FontSize="60" HorizontalAlignment="Center" />
                            <TextBlock Text="No servers yet" Style="{StaticResource HeadingTextStyle}"
                                       HorizontalAlignment="Center" Margin="0,15,0,5" />
                            <TextBlock Text="Click 'Fetch New' to get the latest servers from GitHub"
                                       Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                                      Visibility="{Binding Configs.Count, Converter={StaticResource CountToVis}}">
                            <ItemsControl x:Name="ServerList" ItemsSource="{Binding Configs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ProxyConfig}">
                                        <Border Margin="4,4" CornerRadius="12" Padding="14,10"
                                                Background="#10FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1"
                                                Cursor="Hand" MouseLeftButtonUp="ServerItem_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#337C4DFF" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Protocol Icon -->
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                        Background="{Binding ProtocolColor}" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding ProtocolIcon}" Foreground="White"
                                                               FontSize="14" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <!-- Name and Address -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Address}"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                                <!-- Loading indicator -->
                                                <Border Grid.Column="2" Width="20" Height="20" Margin="0,0,12,0"
                                                        Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="⟳" Foreground="{StaticResource AccentBrush}"
                                                               FontSize="14" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform x:Name="SpinnerRotate" CenterX="10" CenterY="10" />
                                                        </TextBlock.RenderTransform>
                                                        <TextBlock.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                                            From="0" To="360" Duration="0:0:1.2" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </TextBlock.Triggers>
                                                    </TextBlock>
                                                </Border>
                                                <!-- Ping -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="60">
                                                    <TextBlock Text="{Binding PingDisplay}"
                                                               Foreground="{Binding PingColor}"
                                                               FontSize="14" FontWeight="Bold"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Loading Overlay -->
                        <Border x:Name="LoadingOverlay" Background="#CC0A0E27" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⟳" Foreground="{StaticResource PrimaryBrush}" FontSize="40"
                                           FontWeight="Bold" HorizontalAlignment="Center">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="LoadingSpinner" CenterX="20" CenterY="20" />
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:1.5" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                                <TextBlock x:Name="LoadingText" Text="Loading..." Foreground="White" FontSize="14"
                                           HorizontalAlignment="Center" Margin="0,15,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Log Footer -->
                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="10" Margin="0,15,0,0" MaxHeight="120">
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding LogText}" Foreground="{StaticResource TextTertiaryBrush}"
                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon" Visibility="Collapsed"
                        ToolTipText="Mahyar Free VPN"
                        TrayLeftMouseDown="TrayIcon_TrayLeftMouseDown">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="ShowMenuItem" Header="Show Window" Click="ShowMenuItem_Click" />
                    <MenuItem x:Name="ConnectMenuItem" Header="Connect" Click="ConnectMenuItem_Click" />
                    <Separator />
                    <MenuItem x:Name="ExitMenuItem" Header="Exit" Click="ExitMenuItem_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
